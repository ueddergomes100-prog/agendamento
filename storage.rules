rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function manager(salonId) {
      return request.auth != null && firestore.exists(/databases/(default)/documents/salons/$(salonId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/salons/$(salonId)/members/$(request.auth.uid)).data.status == 'ACTIVE'
        && firestore.get(/databases/(default)/documents/salons/$(salonId)/members/$(request.auth.uid)).data.role in ['OWNER','MANAGER'];
    }
    function validImage() {
      return request.resource != null && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg','image/png','image/webp'];
    }
    match /salons/{salonId}/{folder}/{fileName} {
      allow read: if firestore.get(/databases/(default)/documents/publicSalons/$(salonId)).data.published == true || manager(salonId);
      allow create, update: if folder in ['branding','portfolio','services','professionals','campaigns'] && manager(salonId) && validImage();
      allow delete: if manager(salonId);
    }
    match /users/{userId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId && validImage();
    }
  }
}
