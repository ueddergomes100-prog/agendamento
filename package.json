{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "vite build --config vite.vercel.config.ts",
    "preview:vercel": "vite preview --config vite.vercel.config.ts",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/domain.test.mjs && node --import ./tests/register-typescript.mjs --test tests/presentation.test.mjs",
    "test:firebase": "firebase emulators:exec --project demo-salon --only firestore \"node --test functions/test/booking.test.mjs tests/firebase-rules.test.mjs\"",
    "firebase:emulators": "firebase emulators:start --project demo-salon --only auth,firestore,functions,storage",
    "firebase:deploy": "firebase deploy --project agendamento-salao-bfe26 --only functions,firestore,storage"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@electric-sql/pglite": "^0.5.8",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.19.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.30.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.130.0"
  },
  "type": "module"
}
