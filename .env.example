# Keep presentation as default until the Firebase deployment is validated.
VITE_FIREBASE_ENABLED=false
# ?mode=live uses Firebase. ?mode=demo explicitly selects presentation data.
VITE_FIREBASE_EMULATORS=false
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Secrets belong in Google Secret Manager, never in VITE_ or EXPO_PUBLIC_ variables.
